# Server-side Meta Model API credentials. Copy to .env.local and fill in locally;
# never commit real values.
# MODEL_API_KEY=
# META_MODEL=muse-spark-1.3
#
# Demo without network: META_RECORD=1 saves each Meta reply under data/replay/,
# META_REPLAY=1 replays them and never calls the API.
# META_RECORD is for LOCAL use only: on a public deployment it would write every
# visitor's text to disk.
# META_RECORD=1
# META_REPLAY=1
